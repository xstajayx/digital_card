# SERVER ONLY. Copy outside the public static directory. Never commit real values.
SH_ENVIRONMENT=local
SH_DATABASE_URL=postgresql+psycopg://silent_hello:CHANGE_ME@127.0.0.1:5432/silent_hello
SH_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
SH_FRONTEND_URL=http://127.0.0.1:8765/
SH_CORS_ORIGINS=http://127.0.0.1:8765
SH_UPLOADS_ENABLED=false
SH_STORAGE_DRIVER=local
SH_STORAGE_DIR=/tmp/silent-hello-local-media
# Production only: private R2; no bucket public access / r2.dev / public custom domain.
SH_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
SH_R2_BUCKET=silent-hello-private
SH_R2_ACCESS_KEY=
SH_R2_SECRET_KEY=
SH_BACKUP_RETENTION_DAYS=30
SH_ABANDONED_HOURS=48
SH_GENERATED_DAYS=7
SH_FREE_MONTHS=12
SH_PAID_MONTHS=24
SH_MAX_UPLOAD_BYTES=10485760
SH_MAX_OUTPUT_BYTES=2097152
SH_MAX_PIXELS=24000000
SH_MAX_EDGE=10000
SH_OUTPUT_EDGE=1600
SH_MAX_CARD_BYTES=24000
SH_MAX_OWNER_BYTES=104857600
SH_MAX_OWNER_MEDIA=50
SH_MAX_OWNER_CARDS=25
SH_GLOBAL_STORAGE_BYTES=2147483648
SH_DAILY_CARD_QUOTA=25
SH_GLOBAL_DAILY_CARD_QUOTA=250
SH_DAILY_UPLOAD_QUOTA=50
SH_GLOBAL_DAILY_UPLOAD_QUOTA=500
SH_GLOBAL_READ_RATE=600
SH_UPLOAD_RATE=10
SH_WRITE_RATE=60
SH_READ_RATE=240
SH_IP_RATE=600
SH_CLEANUP_BATCH=100
SH_CLEANUP_SECONDS=900
SH_DECODER_TIMEOUT=15
SH_BODY_TIMEOUT_SECONDS=20
# Replace these planning estimates with your actual GBP billing assumptions.
SH_FIXED_MONTHLY_GBP=10
SH_STORAGE_GBP_PER_GB=0.012
SH_WRITES_GBP_PER_MILLION=3.5
SH_READS_GBP_PER_MILLION=0.3
SH_EGRESS_GBP_PER_GB=0.05
